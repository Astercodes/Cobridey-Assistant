{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/workspace.mjs", "use": "@vercel/node" },
    { "src": "api/media.mjs", "use": "@vercel/node" },
    { "src": "api/publish.mjs", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/media", "dest": "/api/media.mjs" },
    { "src": "/api/publish", "dest": "/api/publish.mjs" },
    { "src": "/api/(state|login|action)", "dest": "/api/workspace.mjs" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(app.js|style.css|premium.css|design.js|media.js|blob-client.js)", "dest": "/public/$1" }
  ]
}
