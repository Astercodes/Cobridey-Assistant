PORT=3000
HOST=127.0.0.1
# Required before binding to a non-loopback address. Use a long random value.
WORKSPACE_PASSWORD=

# Vercel only: create a Redis database, then add its REST credentials as server environment variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private Vercel Blob store
BLOB_READ_WRITE_TOKEN=
# Instagram API with Facebook Login; never put these in frontend code
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=
APP_URL=https://cobridey-assistant.vercel.app
# Random strong secret also used by the external scheduler Authorization header
CRON_SECRET=
# Enable only after all storage, account, and scheduler setup is verified
PUBLISHING_ENABLED=false
